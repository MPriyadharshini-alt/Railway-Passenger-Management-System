PORT=5000
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters_long
MONGODB_URI=mongodb://127.0.0.1:27017/railway_platform?replicaSet=rs0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# Production Atlas example; set the real value only in the backend host:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/railway_platform?retryWrites=true&w=majority
# NODE_ENV=production
# JWT_SECRET=<unique random secret with at least 32 characters>
# CORS_ORIGINS=https://<your-frontend-domain>
